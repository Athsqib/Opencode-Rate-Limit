{
  "name": "opencode-quota",
  "version": "1.1.0",
  "description": "Count OpenCode provider requests per day, show them in the TUI footer and as a requests_today tool",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.js"
  },
  "files": [
    "index.ts",
    "tui.js",
    "tui.tsx",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild tui.tsx --format=esm --platform=neutral --jsx=automatic --jsx-import-source=@opentui/solid --target=es2022 --outfile=tui.js"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "quota",
    "usage",
    "rate-limit"
  ],
  "dependencies": {
    "@opentui/solid": "^0.5.17",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "license": "MIT"
}
